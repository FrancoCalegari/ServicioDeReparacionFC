<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cliente <%= cliente.nombre %> | FC</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://kit.fontawesome.com/274f77f0e3.js" crossorigin="anonymous"></script>
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="logo" id="logo">FC</a>
            <div class="nav-links">
                <a href="/" class="nav-link"><i class="fa-solid fa-house"></i> Inicio</a>
                <a href="#contacto-footer" class="nav-link">Contacto</a>
            </div>
        </div>
    </nav>

    <main class="client-page">
        <section class="client-report">
            <div class="report-header">
                <div class="report-badge">
                    <i class="fa-solid fa-clipboard-check"></i>
                    <span>Informe #<%= cliente.codigo %></span>
                </div>
                <h1>Hola, <span class="gradient-text"><%= cliente.nombre %></span></h1>
                <p class="report-greeting"><%= cliente.saludo %></p>
            </div>

            <!-- Tratamiento -->
            <div class="report-card">
                <div class="report-card-header">
                    <i class="fa-solid fa-wrench"></i>
                    <h3>Tratamiento Realizado</h3>
                </div>
                <div class="report-card-body">
                    <ul class="treatment-list">
                        <% cliente.tratamiento.split('\n').forEach(line => { %>
                            <% if (line.trim()) { %>
                            <li><%= line.trim() %></li>
                            <% } %>
                        <% }) %>
                    </ul>
                </div>
            </div>

            <!-- Apps Instaladas -->
            <% if (apps && apps.length > 0) { %>
            <div class="report-card">
                <div class="report-card-header">
                    <i class="fa-solid fa-cube"></i>
                    <h3>Software Instalado</h3>
                </div>
                <div class="report-card-body">
                    <div class="apps-grid">
                        <% apps.forEach(app => { %>
                        <a href="<%= app.link_url %>" target="_blank" rel="noopener" class="app-chip">
                            <img src="<%= app.icono_url %>" alt="<%= app.nombre %>" class="app-icon">
                            <span><%= app.nombre %></span>
                        </a>
                        <% }) %>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- Notas -->
            <% if (cliente.notas) { %>
            <div class="report-card note-card">
                <div class="report-card-header">
                    <i class="fa-solid fa-note-sticky"></i>
                    <h3>Notas</h3>
                </div>
                <div class="report-card-body">
                    <p><%= cliente.notas %></p>
                </div>
            </div>
            <% } %>

            <!-- Problema -->
            <% if (cliente.problema) { %>
            <div class="report-card problem-card">
                <div class="report-card-header">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <h3>Problema Detectado</h3>
                </div>
                <div class="report-card-body">
                    <% cliente.problema.split('\n').forEach(line => { %>
                        <% if (line.trim()) { %>
                        <p><%= line.trim() %></p>
                        <% } %>
                    <% }) %>
                </div>
            </div>
            <% } %>

            <!-- Ficha Técnica Button -->
            <% if (ficha) { %>
            <button id="openFicha" class="btn-primary btn-ficha">
                <i class="fa-solid fa-microchip"></i>
                <span>Ver Ficha Técnica</span>
            </button>
            <% } %>

            <!-- Contacto -->
            <div class="report-card contact-card">
                <div class="report-card-header">
                    <i class="fa-solid fa-address-book"></i>
                    <h3>Datos de Contacto</h3>
                </div>
                <div class="report-card-body">
                    <div class="contact-items">
                        <a href="https://wa.me/5492617735869" target="_blank" class="contact-item">
                            <i class="fa-brands fa-whatsapp"></i>
                            <span><%= cliente.telefono %></span>
                        </a>
                        <a href="<%= cliente.instagram_url %>" target="_blank" class="contact-item">
                            <i class="fa-brands fa-instagram"></i>
                            <span><%= cliente.instagram %></span>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Ficha Técnica Popup -->
        <% if (ficha) { %>
        <div id="fichaPopup" class="modal-overlay">
            <div class="modal-content ficha-modal">
                <button class="modal-close" id="closeFicha">&times;</button>
                <h2><i class="fa-solid fa-server"></i> Ficha Técnica</h2>
                <div class="specs-grid">
                    <% if (ficha.cpu_nombre) { %>
                    <div class="spec-card">
                        <div class="spec-icon"><i class="fa-solid fa-microchip"></i></div>
                        <h4>CPU</h4>
                        <ul>
                            <li><%= ficha.cpu_nombre %></li>
                            <% if (ficha.cpu_potencia) { %><li><%= ficha.cpu_potencia %></li><% } %>
                            <% if (ficha.cpu_fabricante) { %><li><%= ficha.cpu_fabricante %></li><% } %>
                            <li><%= ficha.cpu_arquitectura %></li>
                        </ul>
                    </div>
                    <% } %>

                    <% if (ficha.gpu_nombre) { %>
                    <div class="spec-card">
                        <div class="spec-icon"><i class="fa-solid fa-display"></i></div>
                        <h4>GPU</h4>
                        <ul>
                            <li><%= ficha.gpu_nombre %></li>
                            <% if (ficha.gpu_vram) { %><li>VRAM: <%= ficha.gpu_vram %></li><% } %>
                            <% if (ficha.gpu_fabricante) { %><li><%= ficha.gpu_fabricante %></li><% } %>
                        </ul>
                    </div>
                    <% } %>

                    <% if (ficha.ram_capacidad) { %>
                    <div class="spec-card">
                        <div class="spec-icon"><i class="fa-solid fa-memory"></i></div>
                        <h4>RAM</h4>
                        <ul>
                            <li><%= ficha.ram_capacidad %></li>
                            <% if (ficha.ram_slots) { %><li>Slots: <%= ficha.ram_slots %></li><% } %>
                        </ul>
                    </div>
                    <% } %>

                    <% if (ficha.almacenamiento_nombre) { %>
                    <div class="spec-card">
                        <div class="spec-icon"><i class="fa-solid fa-hard-drive"></i></div>
                        <h4>Almacenamiento</h4>
                        <ul>
                            <li><%= ficha.almacenamiento_nombre %></li>
                            <% if (ficha.almacenamiento_tipo) { %><li>Tipo: <%= ficha.almacenamiento_tipo %></li><% } %>
                            <% if (ficha.almacenamiento_capacidad) { %><li><%= ficha.almacenamiento_capacidad %></li><% } %>
                        </ul>
                    </div>
                    <% } %>

                    <% if (ficha.wifi || ficha.bluetooth || ficha.ethernet) { %>
                    <div class="spec-card">
                        <div class="spec-icon"><i class="fa-solid fa-wifi"></i></div>
                        <h4>Conectividad</h4>
                        <ul>
                            <% if (ficha.wifi) { %><li><i class="fa-solid fa-wifi"></i> <%= ficha.wifi %></li><% } %>
                            <% if (ficha.ethernet) { %><li><i class="fa-solid fa-ethernet"></i> <%= ficha.ethernet %></li><% } %>
                            <% if (ficha.bluetooth) { %><li><i class="fa-brands fa-bluetooth"></i> <%= ficha.bluetooth %></li><% } %>
                        </ul>
                    </div>
                    <% } %>

                    <% if (ficha.placa_base) { %>
                    <div class="spec-card">
                        <div class="spec-icon"><i class="fa-solid fa-server"></i></div>
                        <h4>Placa Base</h4>
                        <ul><li><%= ficha.placa_base %></li></ul>
                    </div>
                    <% } %>

                    <% if (ficha.bios_version) { %>
                    <div class="spec-card">
                        <div class="spec-icon"><i class="fa-solid fa-database"></i></div>
                        <h4>BIOS</h4>
                        <ul>
                            <li><%= ficha.bios_version %></li>
                            <% if (ficha.bios_fecha) { %><li>Fecha: <%= ficha.bios_fecha %></li><% } %>
                        </ul>
                    </div>
                    <% } %>

                    <% if (ficha.pantalla_resolucion || ficha.pantalla_specs) { %>
                    <div class="spec-card">
                        <div class="spec-icon"><i class="fa-solid fa-desktop"></i></div>
                        <h4>Pantalla</h4>
                        <ul>
                            <% if (ficha.pantalla_specs) { %><li><%= ficha.pantalla_specs %></li><% } %>
                            <% if (ficha.pantalla_tipo) { %><li>Tipo: <%= ficha.pantalla_tipo %></li><% } %>
                            <% if (ficha.pantalla_resolucion) { %><li><%= ficha.pantalla_resolucion %></li><% } %>
                            <% if (ficha.pantalla_refresco) { %><li><%= ficha.pantalla_refresco %></li><% } %>
                        </ul>
                    </div>
                    <% } %>

                    <% if (ficha.io_puertos) { %>
                    <div class="spec-card">
                        <div class="spec-icon"><i class="fa-solid fa-plug"></i></div>
                        <h4>Puertos I/O</h4>
                        <ul>
                            <% ficha.io_puertos.split(',').forEach(port => { %>
                                <li><%= port.trim() %></li>
                            <% }) %>
                        </ul>
                    </div>
                    <% } %>

                    <% if (ficha.so_nombre) { %>
                    <div class="spec-card">
                        <div class="spec-icon"><i class="fa-brands fa-windows"></i></div>
                        <h4>Sistema Operativo</h4>
                        <ul>
                            <li><%= ficha.so_nombre %></li>
                            <% if (ficha.so_distribucion) { %><li><%= ficha.so_distribucion %></li><% } %>
                        </ul>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
        <% } %>
    </main>

    <footer class="footer" id="contacto-footer">
        <div class="footer-content">
            <span class="footer-brand">FC</span>
            <div class="footer-links">
                <a href="mailto:francocalegari55@gmail.com" aria-label="Email"><i class="fa-solid fa-envelope"></i></a>
                <a href="https://wa.me/5492617735869" target="_blank" aria-label="WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>
                <a href="https://francocalegari.github.io/PortfolioFrancoCalegari/" target="_blank" aria-label="GitHub"><i class="fa-brands fa-github"></i></a>
            </div>
            <p class="footer-copy">&copy; 2025 Franco Calegari</p>
        </div>
    </footer>

    <script>
        // Ficha Técnica popup
        const openBtn = document.getElementById('openFicha');
        const closeBtn = document.getElementById('closeFicha');
        const popup = document.getElementById('fichaPopup');

        if (openBtn && popup) {
            openBtn.addEventListener('click', () => popup.classList.add('active'));
            closeBtn.addEventListener('click', () => popup.classList.remove('active'));
            popup.addEventListener('click', (e) => {
                if (e.target === popup) popup.classList.remove('active');
            });
        }
    </script>
</body>
</html>
